# Podman quadlet: the TRCR master.
#
# HostName is pinned: the license is bound to a machine fingerprint that
# is derived from the hostname inside a container. trcr-init wrote the
# config under that same name; do not change it later.
#
# Podman grants NET_RAW (ping and traceroute) to the image's user directly,
# so the container runs as uid 65532 from the start.
[Unit]
Description=TRCR master
Requires=trcr-init.service trcr-results-pg.service
After=trcr-init.service trcr-results-pg.service

[Container]
Image=ghcr.io/trcrdev/trcrd:v26.11.0
ContainerName=trcr-master
HostName=trcr-master
Exec=master --config /etc/trcr/master.yaml
Network=trcr.network
PublishPort=8443:8443
PublishPort=8444:8444
PublishPort=127.0.0.1:9101:9101
Environment=TRCR_PG_PASSWORD_FILE=/run/trcr-secrets/pg_password
# Metrics bind to all interfaces inside the container so the port
# published above (on 127.0.0.1 of the host) answers.
Environment=TRCR_METRICS__PROMETHEUS_LISTEN_ADDR=0.0.0.0:9101
Volume=/etc/trcr:/etc/trcr:z
Volume=trcr-master-state.volume:/var/lib/trcr
Volume=trcr-secrets.volume:/run/trcr-secrets:ro
DropCapability=ALL
AddCapability=NET_RAW
NoNewPrivileges=true
HealthCmd=curl -fsS http://127.0.0.1:8081/healthz
HealthInterval=10s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=15s
HealthOnFailure=kill
# Started means healthy, so trcr-enroll finds a master that answers.
Notify=healthy

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target

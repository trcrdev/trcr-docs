# Podman quadlet: the local TRCR agent, measuring from this host.
#
# Host networking, so latency and traceroute reflect the host's own
# interfaces. On its first start it reads the token trcr-enroll wrote,
# enrolls against the master on this host and keeps its identity in its
# volumes; later starts do not enroll again.
#
# Rootful Podman is the supported mode: rootless Podman cannot return the
# TTL-exceeded replies traceroute needs.
#
# Wants=, not Requires=: a failed enrollment job (the master was down for
# a moment) must not leave the agent inactive once the master is back;
# the agent waits for the token file itself and keeps restarting.
[Unit]
Description=TRCR agent (this host)
Wants=trcr-enroll.service
After=trcr-enroll.service

[Container]
Image=ghcr.io/trcrdev/trcrd:v26.11.0
ContainerName=trcr-agent
HostName=trcr-agent-1
Exec=agent --config /etc/trcr/agent.yaml
Network=host
Environment=TRCR_JOIN=127.0.0.1:8444
Environment=TRCR_NODE_ID=trcr-agent-1
Environment=TRCR_ENROLL_FILE=/run/trcr-bootstrap/trcr-agent-1.env
Volume=trcr-agent-etc.volume:/etc/trcr
Volume=trcr-agent-state.volume:/var/lib/trcr
Volume=trcr-bootstrap.volume:/run/trcr-bootstrap:ro
DropCapability=ALL
# ping, batch_ping and traceroute open raw sockets. Remove if this agent
# runs only TCP / HTTP / DNS / SSL probes.
AddCapability=NET_RAW
NoNewPrivileges=true

[Service]
Restart=always

[Install]
WantedBy=multi-user.target

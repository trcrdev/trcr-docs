# Podman quadlet: Grafana with the TRCR dashboards, on 127.0.0.1:3000.
# Optional: skip it on a small host or if you run Grafana elsewhere.
# Login admin; the password is in the secrets volume:
#   podman exec trcr-master cat /run/trcr-secrets/grafana_admin_password
[Unit]
Description=TRCR dashboards (Grafana)
Requires=trcr-init.service trcr-results-pg.service
After=trcr-init.service trcr-results-pg.service

[Container]
Image=docker.io/grafana/grafana:12.2.1-ubuntu
ContainerName=trcr-grafana
Network=trcr.network
PublishPort=127.0.0.1:3000:3000
Environment=GF_SECURITY_ADMIN_USER=admin
Environment=GF_SECURITY_ADMIN_PASSWORD__FILE=/run/trcr-secrets/grafana_admin_password
Environment=GF_USERS_ALLOW_SIGN_UP=false
Environment=GF_AUTH_ANONYMOUS_ENABLED=false
Environment=GF_ANALYTICS_REPORTING_ENABLED=false
Environment=GF_ANALYTICS_CHECK_FOR_UPDATES=false
Environment=GF_DASHBOARDS_DEFAULT_HOME_DASHBOARD_PATH=/var/lib/grafana/dashboards/trcr/trcr-overview.json
Volume=trcr-grafana-data.volume:/var/lib/grafana
Volume=trcr-grafana-provisioning.volume:/etc/grafana/provisioning:ro
Volume=trcr-grafana-dashboards.volume:/var/lib/grafana/dashboards/trcr:ro
Volume=trcr-secrets.volume:/run/trcr-secrets:ro
DropCapability=ALL
NoNewPrivileges=true

[Service]
Restart=always

[Install]
WantedBy=multi-user.target

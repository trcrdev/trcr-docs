# Podman quadlet: PostgreSQL results store for a single-host TRCR install.
# Reads its password from the secrets volume trcr-init filled. Skip this
# unit and point master.yaml at your own database if you have one.
[Unit]
Description=TRCR results store (PostgreSQL)
Requires=trcr-init.service
After=trcr-init.service

[Container]
Image=docker.io/library/postgres:18-trixie
ContainerName=trcr-results-pg
Network=trcr.network
Environment=POSTGRES_USER=trcr
Environment=POSTGRES_DB=trcr_results
Environment=POSTGRES_PASSWORD_FILE=/run/trcr-secrets/pg_password
Volume=trcr-results-pg-data.volume:/var/lib/postgresql
Volume=trcr-secrets.volume:/run/trcr-secrets:ro
HealthCmd=pg_isready -U trcr -d trcr_results
HealthInterval=10s
HealthTimeout=5s
HealthRetries=5
HealthStartPeriod=5s
# The unit counts as started once the health check passes, so the master
# does not start against a database that is still initializing.
Notify=healthy

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
